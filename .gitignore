*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
.eggs/

# ======================================================
# Pytest & Tool Caches
# ======================================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# ======================================================
# IDEs & OS Files
# ======================================================
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# ======================================================
# User Data, Databases & Backups (Local-First Data)
# ======================================================
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

data/
backups/
!data/.gitkeep
!backups/.gitkeep

# ======================================================
# Environment Secrets & Configs
# ======================================================
.env
.env.local
.env.*
!.env.example

# ======================================================
